{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ry3nG/GenieTerm/pkg/wconfig/settings-type",
  "$ref": "#/$defs/SettingsType",
  "$defs": {
    "SettingsType": {
      "properties": {
        "app:*": {
          "type": "boolean"
        },
        "app:globalhotkey": {
          "type": "string"
        },
        "app:dismissarchitecturewarning": {
          "type": "boolean"
        },
        "app:defaultnewblock": {
          "type": "string"
        },
        "app:showoverlayblocknums": {
          "type": "boolean"
        },
        "app:ctrlvpaste": {
          "type": "boolean"
        },
        "app:confirmquit": {
          "type": "boolean"
        },
        "app:disablectrlshiftarrows": {
          "type": "boolean"
        },
        "app:disablectrlshiftdisplay": {
          "type": "boolean"
        },
        "app:focusfollowscursor": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "term"
          ]
        },
        "app:tabbar": {
          "type": "string",
          "enum": [
            "top",
            "left"
          ]
        },
        "app:theme": {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ]
        },
        "app:icon": {
          "type": "string",
          "enum": [
            "default",
            "black",
            "white"
          ]
