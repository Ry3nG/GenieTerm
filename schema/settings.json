        "app:hidetabbar": {
          "type": "boolean"
        },
        "app:hidesidebar": {
          "type": "boolean"
        },
        "app:rightclickpaste": {
          "type": "boolean"
        },
        "term:*": {
          "type": "boolean"
        },
        "term:fontsize": {
          "type": "number"
        },
        "term:fontfamily": {
          "type": "string"
        },
        "term:presentation": {
          "type": "string",
          "enum": [
            "semantic",
            "classic"
          ]
        },
        "term:commandcomposer": {
          "type": "boolean"
        },
        "term:theme": {
          "type": "string"
        },
        "term:disablewebgl": {
          "type": "boolean"
        },
        "term:localshellpath": {
          "type": "string"
